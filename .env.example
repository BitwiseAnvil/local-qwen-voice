# Docker's GPU device index, or an NVIDIA GPU UUID from nvidia-smi -L.
TTS_GPU_DEVICE=0
# Optional: refuse to start unless the GPU name contains this text, e.g. RTX 5090.
TTS_EXPECTED_GPU=
TTS_PORT=8765
# Set to 1 AFTER the initial model downloads to prohibit Hugging Face access.
HF_HUB_OFFLINE=0
TTS_CHUNK_FRAMES=4
# Seconds without speech before the model leaves GPU memory (0 = never). The next
# request restores it from host RAM in about a second; POST /wake does so in advance.
TTS_IDLE_UNLOAD_SECONDS=15
# Talker weight storage: int8 (about 1.3 GB less VRAM) or none (bf16, as before).
TTS_WEIGHT_QUANT=int8
# Static context positions (512-4096). Long replies are split to fit; 2048 restores the old size.
TTS_MAX_SEQ_LEN=1024
